{
  "manifest_version": 3,
  "name": "Personal Agent Browser Context",
  "description": "Sends read-only metadata for the active browser page to the local Personal Agent.",
  "version": "0.1.1",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "service_worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
